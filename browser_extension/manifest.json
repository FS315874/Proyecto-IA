{
  "manifest_version": 3,
  "name": "Desktop Agent Browser Bridge",
  "description": "Control semántico local y limitado para Desktop Agent.",
  "version": "0.18.0",
  "minimum_chrome_version": "102",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  }
}
